# ==========================================
# GearboxTraining — Environment Variables
# ==========================================

# Google Apps Script Web App URL (deploy Code.gs as web app — access: anyone)
SHEET_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Admin dashboard password (never exposed client-side)
ADMIN_PASSWORD=gearbox2025

# Bank transfer details (publicly shown on payment page)
NEXT_PUBLIC_BANK_NAME=GTBank
NEXT_PUBLIC_BANK_ACCOUNT=Your Business Name
NEXT_PUBLIC_ACCOUNT_NUMBER=0000000000

# WhatsApp business number (include country code, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000

# Training details
NEXT_PUBLIC_TRAINING_DATE=July 14–18, 2025
NEXT_PUBLIC_TRAINING_LOCATION=Kano, Nigeria
NEXT_PUBLIC_TOTAL_SLOTS=12
